# Redis (the event broker)
REDIS_HOST=localhost
REDIS_PORT=6379

# Streams
STREAM_NAME=user_events
DEAD_STREAM_NAME=user_events_dead
EVENT_TYPE_USER_CREATED=user.created

# Consumer group
GROUP_NAME=email_group
CONSUMER_NAME=email_consumer_1
BLOCK_MS=5000

# Retry
MAX_RETRIES=3
RETRY_DELAY_SECONDS=1

# Failure demo
FAIL_EMAIL_PREFIX=fail
CRASH_ON_FAIL=0
